---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Arjun R Sharma',
    url: SITE_URL,
  },
  ...(post.data.cover ? { image: new URL(post.data.cover, SITE_URL).toString() } : {}),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-clay)]">
      {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
    </p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight sm:text-5xl">
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-[var(--color-moss)]">{post.data.description}</p>

    {post.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="rounded-full bg-[var(--color-paper-dim)] px-3 py-1 text-xs text-[var(--color-moss)]">
            {tag}
          </span>
        ))}
      </div>
    )}

    {post.data.cover && (
      <img
        src={post.data.cover}
        alt={post.data.coverAlt ?? ''}
        class="mt-8 w-full rounded-xl"
      />
    )}

    <div class="prose-post mt-10">
      <Content />
    </div>

    <div class="mt-16 border-t border-[var(--color-line)] pt-8">
      <a href="/blog" class="text-sm font-medium text-[var(--color-clay)] hover:underline">
        ← Back to all writing
      </a>
    </div>
  </article>
</BaseLayout>
