---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TAGLINE, SITE_DESCRIPTION, SITE_TITLE, SITE_URL, CONTACT_EMAIL } from '../consts';
import { FOCUS_AREAS, BRANDS, INDUSTRIES } from '../data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredAreas = FOCUS_AREAS.slice(0, 6);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_TITLE,
  url: SITE_URL,
  jobTitle: 'Organic Growth Marketer',
  email: CONTACT_EMAIL,
  description: SITE_DESCRIPTION,
  knowsAbout: ['SEO', 'Local SEO', 'Generative Engine Optimization', 'Answer Engine Optimization', 'Organic Growth'],
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </Fragment>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-clay)]">
      Organic Growth Marketer
    </p>
    <h1 class="mt-5 max-w-3xl text-balance font-serif text-4xl font-semibold leading-tight text-[var(--color-ink)] sm:text-5xl">
      {SITE_TAGLINE}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-moss)]">
      Four years of agency-side SEO and growth marketing across
      {INDUSTRIES.join(', ')}. This is where I keep a record of the work and
      write about what's actually changing in search — Local SEO, GEO, AEO,
      and organic growth in general.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/blog"
        class="rounded-full bg-[var(--color-ink)] px-6 py-3 text-sm font-medium text-[var(--color-paper)] transition-colors hover:bg-[var(--color-moss)]"
      >
        Read the blog
      </a>
      <a
        href="/work"
        class="rounded-full border border-[var(--color-line)] px-6 py-3 text-sm font-medium text-[var(--color-ink)] transition-colors hover:border-[var(--color-clay)] hover:text-[var(--color-clay)]"
      >
        See the work
      </a>
    </div>
  </section>

  <!-- Brands -->
  <section class="border-y border-[var(--color-line)] bg-[var(--color-paper-dim)]">
    <div class="mx-auto max-w-5xl px-6 py-10">
      <p class="text-center text-xs font-medium uppercase tracking-widest text-[var(--color-moss-light)]">
        Brands I've worked with
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {BRANDS.map((brand) => (
          <span class="font-serif text-lg text-[var(--color-moss)]">{brand}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Focus areas -->
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="font-serif text-3xl font-semibold">What I write and work on</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {featuredAreas.map((area) => (
        <div class="border-b border-[var(--color-line)] pb-8">
          <h3 class="text-lg font-semibold text-[var(--color-ink)]">{area.title}</h3>
          <p class="mt-2 text-[var(--color-moss)] leading-relaxed">{area.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="border-t border-[var(--color-line)] bg-[var(--color-paper-dim)]">
      <div class="mx-auto max-w-5xl px-6 py-20">
        <div class="flex items-end justify-between gap-6">
          <h2 class="font-serif text-3xl font-semibold">Recent posts</h2>
          <a href="/blog" class="hidden text-sm font-medium text-[var(--color-clay)] hover:underline sm:inline">
            All posts →
          </a>
        </div>
        <div class="mt-10 grid gap-8 sm:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="group block">
              <p class="text-xs uppercase tracking-widest text-[var(--color-moss-light)]">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </p>
              <h3 class="mt-2 font-serif text-xl font-semibold leading-snug text-[var(--color-ink)] group-hover:text-[var(--color-clay)]">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-moss)]">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-6 py-20 text-center">
    <h2 class="mx-auto max-w-xl text-balance font-serif text-3xl font-semibold">
      Want to talk shop, or just say hi?
    </h2>
    <p class="mt-4 text-[var(--color-moss)]">I'm easiest to reach by email.</p>
    <a
      href="/contact"
      class="mt-8 inline-block rounded-full bg-[var(--color-clay)] px-8 py-3 text-sm font-medium text-white transition-colors hover:bg-[var(--color-clay-light)]"
    >
      Get in touch
    </a>
  </section>
</BaseLayout>
