---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES } from '../data/profile';

const title = 'Services';
const description =
  'Technical SEO audits, on-page and content strategy, site migrations, local and national SEO, AI/generative-engine optimization, and ongoing growth retainers.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-12">
    <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-clay)]">Services</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight sm:text-5xl">
      Organic growth work, end to end.
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-[var(--color-moss)]">
      No paid media, no bundled retainers you don't need. Pick what solves the actual
      problem — or ask, and I'll tell you honestly whether SEO is the right lever at all.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="grid gap-px overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-2">
      {SERVICES.map((service, i) => (
        <div class="bg-[var(--color-paper)] p-8">
          <span class="text-xs font-medium text-[var(--color-clay)]">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2 class="mt-3 font-serif text-xl font-semibold text-[var(--color-ink)]">
            {service.title}
          </h2>
          <p class="mt-3 leading-relaxed text-[var(--color-moss)]">{service.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-[var(--color-line)] bg-[var(--color-paper-dim)]">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="font-serif text-3xl font-semibold">Not sure what you need?</h2>
      <p class="mt-4 text-[var(--color-moss)]">
        Send over what you're working with and what's not moving. I'll tell you where I'd start.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block rounded-full bg-[var(--color-clay)] px-8 py-3 text-sm font-medium text-white transition-colors hover:bg-[var(--color-clay-light)]"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
