---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INDUSTRIES } from '../data/profile';

const title = 'About';
const description =
  "Arjun R Sharma's background in organic growth marketing across FMCG, BFSI, travel, and B2B, and what this site is about.";
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <p class="text-sm font-medium uppercase tracking-widest text-[var(--color-clay)]">About</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight sm:text-5xl">
      Organic growth marketer, based on what actually moved the needle.
    </h1>
    <div class="mt-8 space-y-5 text-lg leading-relaxed text-[var(--color-moss)]">
      <p>
        I've spent four years doing agency-side SEO and growth marketing across
        {INDUSTRIES.join(', ')} — working inside teams that had to prove organic
        channel performance against hard revenue numbers, not just rankings.
      </p>
      <p>
        I currently lead growth marketing at Jump Content (Dimerse). This site
        is where I keep a record of the brands I've worked with, and write
        about the parts of SEO that are actually changing right now — Local
        SEO, generative engine optimization (GEO), answer engine optimization
        (AEO), and organic growth strategy more broadly.
      </p>
      <p>
        No fluff, no recycled "10 SEO tips" posts — just what I'm seeing
        work (and not work) in practice, and the projects behind it.
      </p>
    </div>

    <div class="mt-12">
      <a
        href="/work"
        class="inline-block rounded-full bg-[var(--color-ink)] px-6 py-3 text-sm font-medium text-[var(--color-paper)] transition-colors hover:bg-[var(--color-moss)]"
      >
        See the work
      </a>
      <a
        href="/blog"
        class="ml-4 inline-block rounded-full border border-[var(--color-line)] px-6 py-3 text-sm font-medium text-[var(--color-ink)] transition-colors hover:border-[var(--color-clay)] hover:text-[var(--color-clay)]"
      >
        Read the blog
      </a>
    </div>
  </section>
</BaseLayout>
